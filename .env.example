####################################################################
# Example environment file. Copy to `.env` and fill in real values.
# Never commit a filled-in `.env` — it is git-ignored on purpose.
####################################################################

# ---------- Branding (no code changes needed to rebrand) ----------
VITE_APP_NAME="Starpace"
VITE_APP_TAGLINE="Where creators get paid"
VITE_APP_URL="http://localhost:8080"
VITE_SUPPORT_EMAIL="support@example.com"

# ---------- Backend providers (swap implementations by name) ----------
DB_PROVIDER="supabase"          # supabase | postgres
AUTH_PROVIDER="supabase"        # supabase
STORAGE_PROVIDER="supabase"     # supabase | r2 | s3
REALTIME_PROVIDER="supabase"    # supabase
AI_PROVIDER="gateway"           # gateway | openai | openai-compatible
PAYMENTS_PROVIDER="paystack"    # paystack | stripe
EMAIL_PROVIDER="none"           # none | resend | smtp

# ---------- Database / auth (Supabase-compatible) ----------
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- Object storage (Cloudflare R2 / S3 compatible) ----------
STORAGE_BUCKET="media"
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---------- AI ----------
AI_GATEWAY_URL="https://ai.gateway.lovable.dev/v1/chat/completions"
AI_TEXT_MODEL="google/gemini-3-flash-preview"
AI_API_KEY=""                   # used when AI_PROVIDER is not "gateway"
LOVABLE_API_KEY=""              # provisioned automatically for the gateway

# ---------- Payments ----------
PAYMENTS_CURRENCY="NGN"
PAYMENTS_BASE_CURRENCY="USD"
PAYMENTS_USD_RATE="1600"
PAYMENTS_MIN_TIP_USD="0.20"
PAYMENTS_PLATFORM_FEE_BPS="1000"   # 10.00%
PAYMENTS_MIN_PAYOUT_USD="10"
VITE_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------- Security ----------
MESSAGE_ENCRYPTION_KEY=""          # 32-byte base64 key, at-rest message encryption
MESSAGE_ENCRYPTION_KEY_PREVIOUS="" # set during key rotation
MEDIA_URL_SECRET=""                # signs expiring media links
CRON_SECRET=""
CRON_SECRET_PREVIOUS=""
LOVABLE_CRON_SECRET=""
LOVABLE_CRON_SECRET_PREVIOUS=""
